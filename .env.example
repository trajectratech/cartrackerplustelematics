# ---------------------------------------------------------------- Blog CMS
# Supabase project settings > API.

# Safe to expose to the browser: row-level security, not secrecy, protects the
# data behind the anon key.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# BYPASSES row-level security. Server-side only. Never commit, never expose.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Salts commenter IP hashes so raw IPs are never stored.
COMMENT_IP_SALT=

# Any long random string. Lets the CMS regenerate a cached blog page the moment
# a post is published, instead of waiting for the cache window to expire.
VERCEL_BYPASS_TOKEN=

# Absolute origin used when calling back into the site to revalidate.
PUBLIC_SITE_URL=https://www.cartrackerplustelematics.com
