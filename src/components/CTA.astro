---
import { Icon } from "astro-icon/components";
import type { ThemeConfig } from "../types/theme";
import QuoteRequestForm from "./QuoteRequestForm.astro";
export interface Props {
	data: ThemeConfig;
}
const cta = Astro.props.data.content.ctaSection;
const whatsappUrl = Astro.props.data.content.heroSection.ctaUrl;
---

{
	cta && (
		<section id="get-a-quote" class="scrolling-section section-shell text-[var(--color-text)]" aria-labelledby="get-a-quote-heading">
			<div class="container-shell">
				<div class="cta-shell p-10 sm:p-14">
					<div class="grid items-start gap-12 lg:grid-cols-[0.9fr_1.1fr]">
						<div>
							<p class="section-kicker">Get A Quote</p>
							<h2 id="get-a-quote-heading" class="mt-7 max-w-4xl text-[clamp(2.7rem,4.5vw,4.6rem)] font-black leading-[0.95] tracking-[-0.06em] text-[var(--color-heading)]">
								{cta.heading}
							</h2>
							{cta.subheading && (
								<p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--color-text-muted)]">
									{cta.subheading}
								</p>
							)}

							<div class="mt-10 grid gap-4">
								<a
									href={whatsappUrl}
									target="_blank"
									rel="noopener noreferrer"
									data-button
									class="primary-button inline-flex cursor-pointer items-center justify-center gap-2"
								>
									Continue on WhatsApp
									<Icon name="heroicons-solid:external-link" class="h-4 w-4" aria-hidden="true" />
								</a>

							</div>
						</div>

						<div class="premium-panel p-6 sm:p-8">
							<div class="mb-6">
								<p class="eyebrow-label">Online Quote Form</p>
								<p class="mt-4 text-2xl font-black tracking-[-0.05em] text-[var(--color-heading)]">
									Share the job details once and let the team follow up with the right recommendation.
								</p>
							</div>
							<QuoteRequestForm formId="home-quote-form" sourcePage="/#get-a-quote" />
						</div>
					</div>
				</div>
			</div>
		</section>
	)
}
