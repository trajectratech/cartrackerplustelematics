---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getAdminClient, isAdminConfigured } from "../../lib/supabase";
import { CSRF_FIELD, ensureCsrfToken } from "../../lib/csrf";

export const prerender = false;

const csrfToken = ensureCsrfToken(Astro.cookies);
const user = Astro.locals.user;
const statusFilter = Astro.url.searchParams.get("status") ?? "pending";
const notice = Astro.url.searchParams.get("notice");

type CommentRow = {
	id: string;
	display_name: string;
	body: string;
	status: string;
	created_at: string;
	posts: { slug: string; title: string } | null;
};

let comments: CommentRow[] = [];
let loadError: string | null = null;

if (isAdminConfigured()) {
	const supabase = getAdminClient()!;
	let query = supabase
		.from("comments")
		.select("id, display_name, body, status, created_at, posts ( slug, title )");

	if (statusFilter !== "all") query = query.eq("status", statusFilter);

	const { data, error } = await query.order("created_at", { ascending: false }).limit(200);
	if (error) loadError = error.message;
	comments = (data ?? []) as unknown as CommentRow[];
}

const filters = [
	{ label: "Awaiting review", value: "pending" },
	{ label: "Approved", value: "approved" },
	{ label: "Hidden", value: "hidden" },
	{ label: "All", value: "all" },
];

function formatDate(value: string) {
	return new Date(value).toLocaleString("en-NG", {
		year: "numeric",
		month: "short",
		day: "numeric",
		hour: "2-digit",
		minute: "2-digit",
	});
}
---

<AdminLayout title="Comments" user={user} csrfToken={csrfToken}>
	<h1 class="text-3xl font-black tracking-[-0.05em] text-[var(--color-heading)]">Comments</h1>
	<p class="mt-3 max-w-2xl text-sm leading-7 text-[var(--color-text-muted)]">
		New comments arrive as "awaiting review" and are invisible on the site until approved.
	</p>

	{
		notice && (
			<div
				role="status"
				class="mt-6 rounded-[1.2rem] border px-5 py-3 text-sm leading-7"
				style="border-color: color-mix(in srgb, var(--color-success) 30%, transparent); background: color-mix(in srgb, var(--color-success) 10%, transparent);"
			>
				{notice}
			</div>
		)
	}
	{
		loadError && (
			<div
				role="alert"
				class="mt-6 rounded-[1.2rem] border px-5 py-3 text-sm leading-7"
				style="border-color: color-mix(in srgb, var(--color-error) 28%, transparent); background: color-mix(in srgb, var(--color-error) 9%, transparent);"
			>
				Could not load comments: {loadError}
			</div>
		)
	}

	<nav aria-label="Filter comments" class="mt-8 flex flex-wrap gap-2">
		{
			filters.map((filter) => {
				const isCurrent = statusFilter === filter.value;
				return (
					<a
						href={`/admin/comments/?status=${filter.value}`}
						aria-current={isCurrent ? "page" : undefined}
						class="rounded-full px-4 py-2 text-sm font-semibold no-underline"
						style={
							isCurrent
								? "background: color-mix(in srgb, var(--color-primary) 12%, transparent); color: var(--color-primary);"
								: "border: 1px solid var(--border-subtle); color: var(--color-heading);"
						}
					>
						{filter.label}
					</a>
				);
			})
		}
	</nav>

	{
		comments.length === 0 ? (
			<p class="mt-10 text-base leading-8 text-[var(--color-text-muted)]">Nothing here.</p>
		) : (
			<ul class="mt-8 grid list-none gap-3 p-0">
				{comments.map((comment) => (
					<li class="step-card">
						<div class="flex flex-wrap items-baseline justify-between gap-3">
							<p class="text-base font-bold tracking-[-0.02em] text-[var(--color-heading)]">
								{comment.display_name}
							</p>
							<p class="text-sm text-[var(--color-text-muted)]">
								<time datetime={comment.created_at}>{formatDate(comment.created_at)}</time>
								{comment.posts && (
									<>
										{" on "}
										<a href={`/blogs/${comment.posts.slug}/`} target="_blank" rel="noopener">
											{comment.posts.title}
										</a>
									</>
								)}
							</p>
						</div>

						<p class="mt-4 whitespace-pre-wrap text-sm leading-7 text-[var(--color-text-muted)]">
							{comment.body}
						</p>

						<form method="post" action="/admin/comments/actions/" class="mt-5 grid gap-3">
							<input type="hidden" name={CSRF_FIELD} value={csrfToken} />
							<input type="hidden" name="id" value={comment.id} />

							<div class="grid gap-2">
								<label
									class="text-sm font-semibold text-[var(--color-heading)]"
									for={`edit-${comment.id}`}
								>
									Edit before publishing
								</label>
								<textarea
									id={`edit-${comment.id}`}
									name="body"
									rows="3"
									class="rounded-[1rem] border px-4 py-3 text-sm"
									style="border-color: var(--border-subtle); background: color-mix(in srgb, var(--surface-base) 98%, transparent);"
								>{comment.body}</textarea>
							</div>

							<div class="flex flex-wrap gap-2">
								<button
									type="submit"
									name="action"
									value="approve"
									class="secondary-button cursor-pointer px-4 py-2 text-sm"
								>
									Approve
								</button>
								<button
									type="submit"
									name="action"
									value="hide"
									class="secondary-button cursor-pointer px-4 py-2 text-sm"
								>
									Hide
								</button>
								<button
									type="submit"
									name="action"
									value="save"
									class="secondary-button cursor-pointer px-4 py-2 text-sm"
								>
									Save edit
								</button>
								<button
									type="submit"
									name="action"
									value="delete"
									class="secondary-button cursor-pointer px-4 py-2 text-sm"
									style="border-color: color-mix(in srgb, var(--color-error) 40%, transparent); color: var(--color-error) !important;"
								>
									Delete
								</button>
							</div>
						</form>
					</li>
				))}
			</ul>
		)
	}
</AdminLayout>
