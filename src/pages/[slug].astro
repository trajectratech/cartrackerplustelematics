---
import { Icon } from "astro-icon/components";

import type { ThemeConfig } from "../types/theme";
import mainJson from "../data/car-tracker-plus-telematics.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import QuoteRequestForm from "../components/QuoteRequestForm.astro";
import { getLandingPageSeo } from "../utils/seo";
import { formatPhoneNumber } from "../utils/formatPhoneNumber";
import { getAllLandingPages } from "../utils/landingPages";

const data = mainJson as ThemeConfig;
export const prerender = true;

export function getStaticPaths() {
	const theme = mainJson as ThemeConfig;
	const landingPages = getAllLandingPages(theme);

	return landingPages.map((page) => ({
		params: { slug: page.slug },
		props: { page },
	}));
}

const { page } = Astro.props;
const seo = getLandingPageSeo(data, page);
const displayPhone = formatPhoneNumber(data.contact.phone);
const allPages = getAllLandingPages(data);
const relatedPages = allPages.filter((candidate) => page.relatedSlugs?.includes(candidate.slug));
const leadImage = page.images?.[0];
const galleryImages = page.images?.slice(1) ?? [];
const quoteService = page.quoteLabel || page.cardTitle || page.serviceType;

const contentSections = page.sections?.length
	? page.sections
	: [
			{
				title: `Why ${page.serviceType.toLowerCase()} matters`,
				paragraphs: [
					`${data.brand.businessName} helps clients who need ${page.serviceType.toLowerCase()} with clearer recommendations, professional installation standards, and support that stays dependable after the system is deployed.`,
					`If you are comparing providers for ${page.primaryKeyword.replace(/-/g, " ")}, the difference usually comes down to installation quality, ongoing monitoring visibility, and how clearly the system aligns with your specific vehicle or fleet use case.`,
				],
				bullets: page.benefits,
			},
		];

const contentFeatureGroups = page.featureGroups?.length
	? page.featureGroups
	: [
			{
				title: "What you can expect",
				items: [
					...page.benefits,
					`Coverage for ${page.location} enquiries`,
					"Guidance on the best-fit configuration before installation",
				],
			},
		];

const supportCards = [
	{ label: "Talk to us", value: displayPhone, copy: "Call or message for a faster recommendation." },
	{ label: "Coverage", value: page.location, copy: "Installation support matched to your location." },
	{
		label: "Monitoring access",
		value: "Anywhere",
		copy: "Supported systems can be viewed remotely from anywhere with internet access.",
	},
	{ label: "Best fit", value: quoteService, copy: "We narrow down the right setup before you book." },
];

const colorVars = {
	"--color-primary": data.colors.primary,
	"--color-secondary": data.colors.secondary,
	"--color-accent": data.colors.accent,
	"--color-background": data.colors.background,
	"--color-text": data.colors.text,
	"--color-heading": data.colors.heading,
	"--color-link": data.colors.link,
	"--color-hover": data.colors.hover,
	"--color-active": data.colors.active,
	"--color-error": data.colors.error,
	"--color-success": data.colors.success,
	"--color-muted": data.colors.muted,
};
---

<BaseLayout
	data={data}
	layout={[]}
	colorVars={colorVars}
	metadata={seo.metadata}
	structuredData={seo.structuredData}
	sameAsUrls={seo.sameAsUrls}
>
	<section
		class="scrolling-section section-shell landing-hero pt-8"
		data-reveal="off"
		aria-labelledby="page-heading"
	>
		<div class="container-shell">
			<Breadcrumbs items={seo.breadcrumbs} />

			<div class="mt-8 grid items-start gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
				<div>
					<p class="section-kicker">{page.eyebrow || page.serviceType}</p>
					<h1 id="page-heading" class="display-title--compact mt-7 max-w-3xl">
						{page.headline}
					</h1>
					<p class="section-copy max-w-2xl">{page.intro}</p>

					<div class="hero-actions mt-9">
						<a href="#quote-request" data-button class="primary-button cursor-pointer">
							Request a Quote
						</a>
						<a
							href={data.content.heroSection.ctaUrl}
							target="_blank"
							rel="noopener noreferrer"
							data-button
							class="secondary-button cursor-pointer"
						>
							Chat on WhatsApp
						</a>
					</div>

					<ul class="mt-9 grid list-none gap-3 p-0 sm:grid-cols-3">
						{
							page.benefits.map((benefit) => (
								<li class="chip items-start justify-start gap-2.5 px-4 py-3 text-left text-sm leading-6">
									<Icon
										name="heroicons-solid:check-circle"
										class="mt-0.5 h-4 w-4 flex-shrink-0 text-[var(--color-primary)]"
										aria-hidden="true"
									/>
									<span>{benefit}</span>
								</li>
							))
						}
					</ul>
				</div>

				{
					leadImage ? (
						<div class="grid gap-4">
							<figure class="premium-panel overflow-hidden p-4">
								<img
									src={leadImage.src}
									alt={leadImage.alt}
									width={leadImage.width}
									height={leadImage.height}
									class="aspect-[4/3] w-full rounded-[1.7rem] object-cover"
									sizes="(min-width: 1024px) 32rem, 92vw"
									loading="eager"
									decoding="async"
									fetchpriority="high"
								/>
								{leadImage.caption && (
									<figcaption class="px-2 pb-1 pt-5 text-sm leading-7 text-[var(--color-text-muted)]">
										{leadImage.caption}
									</figcaption>
								)}
							</figure>

							<ul class="grid list-none gap-3 p-0 sm:grid-cols-2">
								{supportCards.map((card) => (
									<li class="step-card p-5">
										<p class="eyebrow-label">{card.label}</p>
										<p class="mt-2.5 text-base font-bold tracking-[-0.02em] text-[var(--color-heading)]">
											{card.value}
										</p>
										<p class="mt-2 text-sm leading-6 text-[var(--color-text-muted)]">{card.copy}</p>
									</li>
								))}
							</ul>
						</div>
					) : (
						<aside class="dark-panel p-8 sm:p-10">
							<p class="eyebrow-label">Talk to {data.brand.businessName}</p>
							<ul class="mt-6 grid list-none gap-4 p-0 text-sm leading-7 text-[var(--color-on-dark-muted)]">
								<li>{displayPhone}</li>
								<li>{data.contact.email}</li>
								<li>{data.contact.address}</li>
								<li>Coverage: {(data.seo?.serviceAreas || ["Nigeria"]).join(", ")}</li>
							</ul>
						</aside>
					)
				}
			</div>
		</div>
	</section>

	<section class="scrolling-section section-shell" data-surface="muted" aria-label="Overview">
		<div class="container-shell grid gap-5 lg:grid-cols-2">
			{
				contentSections.map((section) => (
					<article class="premium-panel p-8 sm:p-9">
						<h2 class="text-2xl font-bold tracking-[-0.035em] text-[var(--color-heading)]">
							{section.title}
						</h2>
						{section.paragraphs?.map((paragraph) => (
							<p class="mt-4 text-base leading-8 text-[var(--color-text-muted)]">{paragraph}</p>
						))}
						{section.bullets?.length ? (
							<ul class="check-list mt-6">
								{section.bullets.map((bullet) => (
									<li class="list-check">{bullet}</li>
								))}
							</ul>
						) : null}
					</article>
				))
			}
		</div>
	</section>

	{
		page.packages?.length ? (
			<section class="scrolling-section section-shell" aria-labelledby="packages-heading">
				<div class="container-shell">
					<div class="section-heading-center">
						<p class="section-kicker">Options</p>
						<h2 id="packages-heading" class="section-title measure-14">
							Choose the right configuration
						</h2>
					</div>

					<ul
						class="mt-14 grid list-none gap-4 p-0 md:grid-cols-2"
						class:list={[page.packages.length >= 4 ? "xl:grid-cols-4" : "xl:grid-cols-2"]}
					>
						{page.packages.map((pkg) => (
							<li class="premium-panel flex h-full flex-col p-7">
								<div class="flex flex-wrap items-start justify-between gap-3">
									<h3 class="text-xl font-bold tracking-[-0.03em] text-[var(--color-heading)]">
										{pkg.name}
									</h3>
									{pkg.price && <span class="chip px-3 py-2 text-xs">{pkg.price}</span>}
								</div>

								{pkg.summary && (
									<p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">{pkg.summary}</p>
								)}

								<ul class="check-list mt-5 text-sm">
									{pkg.features.map((feature) => (
										<li class="list-check">{feature}</li>
									))}
								</ul>

								{pkg.idealFor?.length ? (
									<div
										class="mt-auto pt-5"
										style="border-top: 1px solid var(--border-subtle);"
									>
										<p class="eyebrow-label">Ideal for</p>
										<ul class="mt-3 flex list-none flex-wrap gap-2 p-0">
											{pkg.idealFor.map((item) => (
												<li class="rounded-full px-3 py-1.5 text-xs font-semibold" style="background: color-mix(in srgb, var(--color-primary) 9%, transparent); color: var(--color-heading);">
													{item}
												</li>
											))}
										</ul>
									</div>
								) : null}
							</li>
						))}
					</ul>
				</div>
			</section>
		) : null
	}

	<section
		class="scrolling-section section-shell"
		data-surface={page.packages?.length ? "muted" : undefined}
		aria-labelledby="features-heading"
	>
		<div class="container-shell">
			<div class="section-heading-center">
				<p class="section-kicker">Capabilities</p>
				<h2 id="features-heading" class="section-title measure-14">
					What the system does
				</h2>
			</div>

			<ul class="mt-14 grid list-none gap-4 p-0 md:grid-cols-2 xl:grid-cols-3">
				{
					contentFeatureGroups.map((group) => (
						<li class="step-card flex h-full flex-col">
							<h3 class="eyebrow-label">{group.title}</h3>
							<ul class="check-list mt-5 text-sm">
								{group.items.map((item) => (
									<li class="list-check">{item}</li>
								))}
							</ul>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	{
		page.calloutGroups?.map((group) => (
			<section
				class="scrolling-section section-shell"
				data-surface={group.tone === "accent" ? "muted" : undefined}
				aria-label={group.title}
			>
				<div class="container-shell">
					<div class="max-w-3xl">
						<h2 class="text-[clamp(1.9rem,3vw,2.6rem)] font-bold leading-tight tracking-[-0.04em] text-[var(--color-heading)]">
							{group.title}
						</h2>
						{group.intro && <p class="section-copy">{group.intro}</p>}
					</div>

					<ul class="mt-12 grid list-none gap-4 p-0 md:grid-cols-2 xl:grid-cols-3">
						{group.items.map((item) => (
							<li class={group.tone === "accent" ? "premium-panel p-7" : "step-card p-7"}>
								<h3 class="text-lg font-bold tracking-[-0.025em] text-[var(--color-heading)]">
									{item.title}
								</h3>
								<p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
									{item.description}
								</p>
							</li>
						))}
					</ul>
				</div>
			</section>
		))
	}

	{
		(page.audiences?.length || page.processSteps?.length) && (
			<section class="scrolling-section section-shell" data-surface="muted" aria-label="Who it suits and how installation works">
				<div class="container-shell grid gap-5 lg:grid-cols-[0.95fr_1.05fr]">
					{page.audiences?.length ? (
						<article class="premium-panel p-8 sm:p-9">
							<h2 class="text-2xl font-bold tracking-[-0.035em] text-[var(--color-heading)]">
								Who this suits
							</h2>
							<ul class="mt-6 flex list-none flex-wrap gap-2 p-0">
								{page.audiences.map((audience) => (
									<li class="chip px-4 py-2.5 text-sm">{audience}</li>
								))}
							</ul>
						</article>
					) : null}

					{page.processSteps?.length ? (
						<article class="premium-panel p-8 sm:p-9">
							<h2 class="text-2xl font-bold tracking-[-0.035em] text-[var(--color-heading)]">
								How installation works
							</h2>
							<ol class="mt-6 grid list-none gap-3 p-0">
								{page.processSteps.map((step, index) => (
									<li class="flex items-start gap-4 rounded-[1.2rem] p-4" style="background: color-mix(in srgb, var(--surface-subtle) 55%, transparent);">
										<span
											class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full text-sm font-bold"
											style="background: var(--color-primary); color: var(--color-on-primary);"
											aria-hidden="true"
										>
											{index + 1}
										</span>
										<span class="text-sm font-semibold leading-7 text-[var(--color-heading)]">
											{step}
										</span>
									</li>
								))}
							</ol>
						</article>
					) : null}
				</div>
			</section>
		)
	}

	{
		page.bestPractices && (
			<section class="scrolling-section section-shell" aria-labelledby="best-practices-heading">
				<div class="container-shell">
					<div class="cta-shell p-8 sm:p-11">
						<div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
							<div>
								<p class="section-kicker">Deployment</p>
								<h2
									id="best-practices-heading"
									class="mt-6 text-[clamp(1.9rem,3vw,2.6rem)] font-bold leading-tight tracking-[-0.04em] text-[var(--color-heading)]"
								>
									{page.bestPractices.title}
								</h2>
								{page.bestPractices.intro && (
									<p class="mt-4 text-base leading-8 text-[var(--color-text-muted)]">
										{page.bestPractices.intro}
									</p>
								)}
							</div>
							<ul class="check-list sm:grid-cols-2">
								{page.bestPractices.items.map((item) => (
									<li class="list-check">{item}</li>
								))}
							</ul>
						</div>
					</div>
				</div>
			</section>
		)
	}

	{
		galleryImages.length > 0 && (
			<section class="scrolling-section section-shell" data-surface="muted" aria-label="Installation gallery">
				<div class="container-shell">
					<ul class="grid list-none gap-4 p-0 sm:grid-cols-2 xl:grid-cols-3">
						{galleryImages.map((image) => (
							<li class="premium-card overflow-hidden">
								<figure class="m-0">
									<img
										src={image.src}
										alt={image.alt}
										width={image.width}
										height={image.height}
										class="aspect-[4/3] w-full object-cover"
										sizes="(min-width: 1280px) 24rem, (min-width: 640px) 45vw, 92vw"
										loading="lazy"
										decoding="async"
									/>
									{image.caption && (
										<figcaption class="px-5 py-4 text-sm leading-7 text-[var(--color-text-muted)]">
											{image.caption}
										</figcaption>
									)}
								</figure>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	{
		page.faqs?.length ? (
			<section class="scrolling-section section-shell" aria-labelledby="faq-heading">
				<div class="container-shell">
					<div class="section-heading-center">
						<p class="section-kicker">FAQs</p>
						<h2 id="faq-heading" class="section-title measure-12">
							{page.serviceType} questions
						</h2>
					</div>

					<div class="mx-auto mt-14 grid max-w-4xl gap-3">
						{page.faqs.map((faq, index) => (
							<details class="faq-item" open={index === 0}>
								<summary class="cursor-pointer list-none">
									<div class="flex items-start justify-between gap-5">
										<h3 class="text-base font-semibold leading-7 text-[var(--color-heading)]">
											{faq.question}
										</h3>
										<span class="faq-toggle flex-shrink-0" aria-hidden="true">
											<Icon
												name="heroicons-solid:chevron-down"
												class="h-5 w-5"
												style="color: var(--color-heading);"
											/>
										</span>
									</div>
								</summary>
								<p class="mt-4 text-base leading-8 text-[var(--color-text-muted)]">{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		) : null
	}

	{
		page.relatedServiceNames && (
			<section class="scrolling-section section-shell" data-surface="muted" aria-labelledby="pair-heading">
				<div class="container-shell">
					<div class="max-w-3xl">
						<h2
							id="pair-heading"
							class="text-[clamp(1.9rem,3vw,2.6rem)] font-bold leading-tight tracking-[-0.04em] text-[var(--color-heading)]"
						>
							{page.relatedServiceNames.title}
						</h2>
						{page.relatedServiceNames.intro && (
							<p class="section-copy">{page.relatedServiceNames.intro}</p>
						)}
					</div>
					<ul class="mt-10 flex list-none flex-wrap gap-2.5 p-0">
						{page.relatedServiceNames.items.map((item) => (
							<li class="chip px-4 py-2.5 text-sm">
								<Icon
									name="heroicons-solid:shield-check"
									class="h-4 w-4 text-[var(--color-primary)]"
									aria-hidden="true"
								/>
								<span>{item}</span>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	{
		relatedPages.length > 0 && (
			<section class="scrolling-section section-shell" aria-labelledby="related-heading">
				<div class="container-shell">
					<div class="section-heading-center">
						<p class="section-kicker">Related Services</p>
						<h2 id="related-heading" class="section-title measure-12">
							Explore the next protection layer
						</h2>
					</div>
					<ul class="mt-14 grid list-none gap-4 p-0 md:grid-cols-2 xl:grid-cols-3">
						{relatedPages.map((related) => (
							<li class="step-card flex h-full flex-col">
								<p class="eyebrow-label">{related.cardTitle || related.serviceType}</p>
								<h3 class="mt-3 text-xl font-bold tracking-[-0.03em] text-[var(--color-heading)]">
									{related.headline}
								</h3>
								<p class="mt-3 flex-1 text-sm leading-7 text-[var(--color-text-muted)]">
									{related.cardDescription || related.intro}
								</p>
								<a
									href={`/${related.slug}/`}
									class="mt-6 inline-flex items-center gap-2 text-sm font-semibold no-underline"
								>
									View details<span class="sr-only">: {related.cardTitle || related.headline}</span>
									<span aria-hidden="true">→</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<section id="quote-request" class="scrolling-section section-shell" data-surface="muted" aria-labelledby="quote-heading">
		<div class="container-shell">
			<div class="cta-shell p-8 sm:p-10 lg:p-12">
				<div class="grid items-start gap-10 lg:grid-cols-[0.9fr_1.1fr]">
					<div>
						<p class="section-kicker">Get a Quote</p>
						<h2
							id="quote-heading"
							class="mt-7 text-[clamp(2.1rem,3.4vw,3.2rem)] font-bold leading-[1.05] tracking-[-0.04em] text-[var(--color-heading)]"
						>
							{page.closing?.title ??
								`Request ${quoteService.toLowerCase()} pricing and installation support`}
						</h2>

						{
							(
								page.closing?.paragraphs ?? [
									"Tell us what you want to install, where the vehicle is, and how many vehicles you need covered. You can continue on WhatsApp or reach out directly for a structured response.",
								]
							).map((paragraph) => (
								<p class="mt-5 max-w-xl text-base leading-8 text-[var(--color-text-muted)]">
									{paragraph}
								</p>
							))
						}

						<div class="mt-9 grid gap-4">
							<a
								href={data.content.heroSection.ctaUrl}
								target="_blank"
								rel="noopener noreferrer"
								data-button
								class="primary-button cursor-pointer"
							>
								Continue on WhatsApp
							</a>
							<div class="step-card p-5">
								<p class="eyebrow-label">Direct contact</p>
								<p class="mt-2.5 text-base font-semibold text-[var(--color-heading)]">
									{displayPhone}
								</p>
								<p class="mt-1 text-sm text-[var(--color-text-muted)]">{data.contact.email}</p>
							</div>
						</div>
					</div>

					<div class="premium-panel p-6 sm:p-8">
						<QuoteRequestForm
							formId={`quote-form-${page.slug}`}
							prefillService={quoteService}
							sourcePage={`/${page.slug}/`}
						/>
					</div>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
