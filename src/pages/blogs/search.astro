---
import type { ThemeConfig } from "../../types/theme";
import mainJson from "../../data/car-tracker-plus-telematics.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PostCard from "../../components/blog/PostCard.astro";
import { getBlogIndexSeo } from "../../utils/seo";
import { getColorVars } from "../../utils/theme";
import {
	searchLivePosts,
	type BlogFeedResult,
	type BlogPost,
} from "../../lib/posts";

export const prerender = false;

const data = mainJson as ThemeConfig;
const colorVars = getColorVars(data);

Astro.response.headers.set(
	"Cache-Control",
	"public, max-age=0, s-maxage=60, stale-while-revalidate=3600, stale-if-error=2592000"
);

const rawQuery = (Astro.url.searchParams.get("q") ?? "").trim();
const query = rawQuery.slice(0, 200);
const didSearch = query.length > 0;

const searchResult: BlogFeedResult = didSearch
	? await searchLivePosts(query)
	: { status: "ok", data: [], count: 0, totalPages: 1, errorMessage: null };

const posts: BlogPost[] = searchResult.data;

// For the "jump into a recent guide" callout that used to render hard-coded
// articles before — instead show the latest 3 from the DB, only when the DB
// is reachable and we're on the no-query landing view.
const recents: BlogPost[] = !didSearch && searchResult.status !== "unconfigured"
	? (await (async () => {
			try {
				// Import lazily so the file's top-level types stay tight.
				const { getLivePosts } = await import("../../lib/posts");
				const latest = await getLivePosts(undefined, { page: 1, perPage: 3 });
				return latest.status === "ok" ? latest.data : [];
			} catch {
				return [];
			}
		})())
	: [];

const seo = getBlogIndexSeo(data, 1, 1);
const metaTitle = didSearch
	? searchResult.status === "ok" || searchResult.status === "empty"
		? posts.length
			? `“${query}” — ${posts.length} result${posts.length === 1 ? "" : "s"} | CTPT Blog`
			: `No results for “${query}” | CTPT Blog`
		: searchResult.status === "unconfigured"
			? "Blog search unavailable | CTPT Blog"
			: "Blog search error | CTPT Blog"
	: "Search the CTPT Blog | Car Tracker Plus Telematics";
const metaDescription = didSearch
	? searchResult.status === "ok" || searchResult.status === "empty"
		? posts.length
			? `${posts.length} article${posts.length === 1 ? "" : "s"} matching “${query}” in the Car Tracker Plus Telematics blog.`
			: `No blog articles matched “${query}”. Try a simpler or broader query.`
		: searchResult.status === "unconfigured"
			? "The blog CMS is not connected yet. Search is unavailable until Supabase credentials are configured."
			: "The blog search could not run right now. Please try again shortly."
	: "Search the Car Tracker Plus Telematics blog for telematics guides, fleet cost studies, dashcam value and premium vehicle tracking articles.";
---

<BaseLayout
	data={data}
	layout={[]}
	colorVars={colorVars}
	metadata={{
		...seo.metadata,
		title: metaTitle,
		ogTitle: metaTitle,
		description: metaDescription,
		robots: "noindex, follow",
	}}
>
	<section class="scrolling-section section-shell pt-8" data-reveal="off" aria-labelledby="search-heading">
		<div class="container-shell">
			<Breadcrumbs items={[
				{ label: "Home", href: "/" },
				{ label: "Blog", href: "/blogs/" },
				{ label: "Search", href: "/blogs/search/" },
			]} />

			<div class="mt-8 grid items-start gap-10 max-w-4xl">
				<div>
					<p class="section-kicker">Blog search</p>
					<h1 id="search-heading" class="display-title--compact mt-7 tracking-tight">
						Search the CTPT Blog
					</h1>
					<p class="section-copy max-w-2xl mt-5">
						Look up guides on telematics setup, dashcam ROI, fleet fuel economics, executive vehicle
						visibility, and premium tracking discipline.
					</p>
				</div>
			</div>

			<form method="get" action="/blogs/search/" class="mt-10 max-w-3xl grid gap-4 sm:grid-cols-[1fr_auto]">
				<label class="sr-only" for="q">Search term</label>
				<input
					id="q"
					name="q"
					type="search"
					value={query}
					placeholder="Try: dashcam value, fleet cost, fuel monitoring..."
					autocomplete="off"
					spellcheck="false"
					enterkeyhint="search"
					required
					class="min-h-14 rounded-[1rem] border px-5 text-sm"
					style="border-color: var(--border-subtle); background: color-mix(in srgb, var(--surface-base) 98%, transparent);"
				/>
				<button type="submit" data-button class="primary-button cursor-pointer min-h-14">
					Search
				</button>
			</form>
		</div>
	</section>

	<section class="scrolling-section section-shell" data-surface="muted">
		<div class="container-shell">
			{
				searchResult.status === "unconfigured" && (
					<div class="premium-panel p-9 max-w-3xl">
						<div class="flex items-start gap-4">
							<div class="mt-1 flex h-10 w-10 flex-none items-center justify-center rounded-full"
								style="background: color-mix(in srgb, var(--color-primary) 12%, transparent); color: var(--color-primary);">
								!
							</div>
							<div>
								<h2 class="text-xl font-bold tracking-[-0.03em] text-[var(--color-heading)]">
									Blog CMS is not connected yet
								</h2>
								<p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
									Search is only available once Supabase credentials are configured and the blog seed
									migration has run. Without a connected database there are no real articles to search,
									so this page deliberately shows nothing instead of placeholder text.
								</p>
								<div class="mt-6 flex flex-wrap gap-3">
									<a href="/blogs/" class="primary-button cursor-pointer">Back to the blog index</a>
								</div>
							</div>
						</div>
					</div>
				)
			}

			{
				searchResult.status === "error" && (
					<div class="premium-panel p-9 max-w-3xl">
						<div class="flex items-start gap-4">
							<div class="mt-1 flex h-10 w-10 flex-none items-center justify-center rounded-full"
								style="background: color-mix(in srgb, var(--color-error) 18%, transparent); color: var(--color-error);">
								!
							</div>
							<div>
								<h2 class="text-xl font-bold tracking-[-0.03em] text-[var(--color-heading)]">
									The blog search could not run right now
								</h2>
								<p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
									The database search query failed. The problem is usually temporary — please try again
									in a moment. The server reported:
								</p>
								<p class="mt-4 rounded-xl border p-4 text-xs font-mono"
									style="border-color: var(--border-subtle); background: color-mix(in srgb, var(--surface-base) 94%, transparent); color: var(--color-text);">
									{searchResult.errorMessage}
								</p>
							</div>
						</div>
					</div>
				)
			}

			{
				searchResult.status !== "unconfigured" && searchResult.status !== "error" && !didSearch && (
					<div class="premium-panel p-9 max-w-3xl">
						<h2 class="text-xl font-bold tracking-[-0.03em] text-[var(--color-heading)]">
							Start with a phrase
						</h2>
						<p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
							Type a topic above, or browse from the latest published articles:
						</p>
						{recents.length > 0 ? (
							<ul class="mt-6 grid list-none gap-4 p-0 md:grid-cols-3">
								{recents.map((post) => (
									<li class="step-card">
										<a href={`/blogs/${post.slug}/`} class="block p-5 no-underline">
											{post.categories?.name && (
												<p class="text-xs font-bold uppercase tracking-[0.14em] text-[var(--color-text-muted)]">
													{post.categories.name}
												</p>
											)}
											<p class="mt-2 text-base font-bold leading-7 text-[var(--color-heading)]">
												{post.title}
											</p>
										</a>
									</li>
								))}
							</ul>
						) : (
							<p class="mt-6 step-card p-5 text-sm leading-7 text-[var(--color-text-muted)]">
								No published articles are available yet.
							</p>
						)}
					</div>
				)
			}

			{
				didSearch && (searchResult.status === "ok" || searchResult.status === "empty") && posts.length > 0 && (
					<>
						<p class="section-copy max-w-2xl text-sm">
							<strong>{posts.length}</strong>
							{posts.length === 1 ? " article " : " articles "}
							matched <strong>“{query}”</strong>.
						</p>
						<ul class="mt-8 grid list-none gap-5 p-0 sm:grid-cols-2 lg:grid-cols-3">
							{posts.map((post) => <PostCard post={post} />)}
						</ul>
					</>
				)
			}

			{
				didSearch && (searchResult.status === "ok" || searchResult.status === "empty") && posts.length === 0 && (
					<div class="premium-panel p-9 max-w-3xl">
						<h2 class="text-xl font-bold tracking-[-0.03em] text-[var(--color-heading)]">
							No articles matched “{query}”
						</h2>
						<p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
							Try fewer words, different spelling, or a broader topic (e.g. “dashcam”, “fleet”, or
							“fuel”).
						</p>
					</div>
				)
			}
		</div>
	</section>
</BaseLayout>
