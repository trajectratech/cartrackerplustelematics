---
import type { ThemeConfig } from "../../types/theme";
import mainJson from "../../data/car-tracker-plus-telematics.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PostCard from "../../components/blog/PostCard.astro";
import { getBlogIndexSeo } from "../../utils/seo";
import { getColorVars } from "../../utils/theme";
import {
	POSTS_PER_PAGE,
	getLivePosts,
	type BlogFeedResult,
} from "../../lib/posts";

export const prerender = false;

const data = mainJson as ThemeConfig;
const colorVars = getColorVars(data);

Astro.response.headers.set(
	"Cache-Control",
	"public, max-age=0, s-maxage=120, stale-while-revalidate=3600, stale-if-error=2592000"
);

const pageNumber = 1;
const feed: BlogFeedResult = await getLivePosts(undefined, {
	page: pageNumber,
	perPage: POSTS_PER_PAGE,
});

const posts = feed.status === "ok" ? feed.data : [];
const totalCount = feed.status === "ok" ? feed.count : 0;
const totalPages = feed.status === "ok" ? feed.totalPages : 1;

const seo = getBlogIndexSeo(
	data,
	pageNumber,
	feed.status === "empty" || feed.status === "ok" ? totalPages : 1,
);
---

<BaseLayout
	data={data}
	layout={[]}
	colorVars={colorVars}
	metadata={seo.metadata}
	structuredData={seo.structuredData}
	sameAsUrls={seo.sameAsUrls}
>
	<section class="scrolling-section section-shell pt-8" data-reveal="off" aria-labelledby="blog-heading">
		<div class="container-shell">
			<Breadcrumbs items={seo.breadcrumbs} />

			<div class="mt-8 grid items-start gap-10">
				<div>
					<p class="section-kicker">Car Tracker Plus Telematics</p>
					<h1 id="blog-heading" class="display-title--compact mt-7 max-w-3xl">
						{seo.metadata?.ogTitle?.replace(" | Car Tracker Plus Telematics", "") ?? "Premium fleet telematics and dashcam insights"}
					</h1>
					<p class="section-copy max-w-2xl mt-5">
						Practical telematics guides, fleet cost studies, dashcam value analysis, and premium
						vehicle tracking discipline — written for Nigerian fleet operators and executive drivers.
					</p>

					<div class="hero-actions mt-9 flex flex-wrap gap-4">
						<a href="#articles-grid" data-button class="primary-button cursor-pointer">
							Browse latest articles
						</a>
						<a href="/blogs/search/" data-button class="secondary-button cursor-pointer">
							Search the blog
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="articles-grid" class="scrolling-section section-shell" data-surface="muted">
		<div class="container-shell">
			{
				feed.status === "unconfigured" && (
					<div class="premium-panel p-9 max-w-3xl">
						<div class="flex items-start gap-4">
							<div class="mt-1 flex h-10 w-10 flex-none items-center justify-center rounded-full"
								style="background: color-mix(in srgb, var(--color-primary) 12%, transparent); color: var(--color-primary);">
								!
							</div>
							<div>
								<h2 class="text-xl font-bold tracking-[-0.03em] text-[var(--color-heading)]">
									Blog CMS is not connected yet
								</h2>
								<p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
									The Car Tracker Plus Telematics blog CMS is configured but the database connection credentials are not
									available on this server. Once <code>SUPABASE_URL</code> and <code>SUPABASE_ANON_KEY</code> are set and the
									blog seed migration has run, articles will appear here automatically.
								</p>
							</div>
						</div>
					</div>
				)
			}

			{
				feed.status === "error" && (
					<div class="premium-panel p-9 max-w-3xl">
						<div class="flex items-start gap-4">
							<div class="mt-1 flex h-10 w-10 flex-none items-center justify-center rounded-full"
								style="background: color-mix(in srgb, var(--color-error) 18%, transparent); color: var(--color-error);">
								!
							</div>
							<div>
								<h2 class="text-xl font-bold tracking-[-0.03em] text-[var(--color-heading)]">
									The blog database could not be loaded
								</h2>
								<p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
									We could not reach the blog database. The issue usually resolves itself in a moment — please
									refresh. If the problem persists the technical detail logged by the server is:
								</p>
								<p class="mt-4 rounded-xl border p-4 text-xs font-mono"
									style="border-color: var(--border-subtle); background: color-mix(in srgb, var(--surface-base) 94%, transparent); color: var(--color-text);">
									{feed.errorMessage}
								</p>
							</div>
						</div>
					</div>
				)
			}

			{
				(feed.status === "ok" || feed.status === "empty") && (
					<>
						<div class="flex flex-wrap items-baseline justify-between gap-5">
							<div>
								<h2 class="section-title">Latest articles</h2>
								<p class="section-copy mt-3 max-w-2xl">
									{totalCount === 0
										? "No articles have been published yet."
										: totalCount === 1
											? "One article on installation best-practice, fleet economics, and dashcam ROI right now."
											: `${totalCount} articles on installation best-practice, fleet economics, and dashcam ROI.`}
								</p>
							</div>
						</div>

						<ul class="mt-10 grid list-none gap-5 p-0 sm:grid-cols-2 lg:grid-cols-3">
							{posts.map((post, index) => <PostCard post={post} eager={index === 0} />)}
						</ul>

						{feed.status === "empty" && (
							<div class="mt-10 premium-panel p-9 max-w-3xl">
								<h2 class="text-xl font-bold tracking-[-0.03em] text-[var(--color-heading)]">
									No published articles yet
								</h2>
								<p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
									The blog CMS is online and ready, but there are no published articles in the database yet.
									Use the admin panel at <a href="/admin/posts/new/" class="underline font-semibold">/admin/posts/new/</a> to
									publish the first article, or run the seed SQL to populate the example posts.
								</p>
							</div>
						)}

						{totalPages > 1 && (
							<nav aria-label="Blog pages" class="mt-12 flex flex-wrap items-center justify-center gap-3">
								{
									Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) =>
										pageNum === pageNumber ? (
											<span aria-current="page" class="rounded-full px-4 py-2 text-sm font-semibold"
												style="background: color-mix(in srgb, var(--color-primary) 12%, transparent); color: var(--color-primary);">
												{pageNum}
											</span>
										) : (
											<a href={pageNum === 1 ? "/blogs/" : `/blogs/page/${pageNum}/`}
												class="rounded-full px-4 py-2 text-sm font-semibold no-underline"
												style="color: var(--color-heading);">
												{pageNum}
											</a>
										)
									)
								}
							</nav>
						)}
					</>
				)
			}
		</div>
	</section>
</BaseLayout>
